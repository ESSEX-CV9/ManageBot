# Discord Bot 基础配置（必填）
DISCORD_TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_application_id

# 命令注册目标服务器ID列表（必填，逗号分隔）
# 示例：GUILD_IDS=123456789012345678,987654321098765432
GUILD_IDS=your_guild_id_1,your_guild_id_2

# ===== 代理（可选） =====
# 当本机无法直连 Discord（DNS 污染/被墙）时填写。会让 REST 与网关连接都走代理。
# 例如 Clash 默认端口：
# PROXY_URL=http://127.0.0.1:7890

# ===== 命令同步策略（可选） =====
# clientReady 时会向 GUILD_IDS 列表逐个 rest.put 刷新命令。
# 若开启严格模式，当任意 guild 注册失败时将直接抛错中止启动（推荐测试环境开启）。
STRICT_COMMAND_SYNC=false

# 可选：清空该应用的全局命令（Global Commands）。
# 适用于曾用同一个 bot token/应用注册过全局命令、导致测试服残留旧命令的情况。
# 注意：全局命令的传播/删除在 Discord 侧可能有缓存延迟（通常可达 ~1 小时）。
CLEAR_GLOBAL_COMMANDS=false

# ===== 诊断/稳健性（可选） =====
# REST 请求超时（毫秒）。默认 15000。
DISCORD_REST_TIMEOUT_MS=15000

# 定期输出健康日志（分钟）。0=关闭。
HEALTH_LOG_INTERVAL_MINUTES=0

# 若发生 uncaughtException 时是否直接退出进程（true/false）。建议配合 pm2 等守护工具使用。
FATAL_EXIT_ON_EXCEPTION=false

# 紧急消息清理：同一频道两次历史分页读取的最小间隔（毫秒）。默认 1100，范围 250-10000。
# 如果仍频繁出现 GET /channels/:id/messages 限流日志，可提高到 1300-1500。
MESSAGE_CLEANUP_HISTORY_PAGE_INTERVAL_MS=1100

# 交互调试日志（true/false）。用于排查“命令无响应但控制台无日志”。
INTERACTION_DEBUG_LOG=false

# ===== 分管身份组轮替模块（可选） =====
# 后台检查月度问询、到期结算和招募状态的间隔（毫秒），最低 5000，默认 30000。
ROLE_ROTATION_TICK_MS=30000

# ===== 募选模块：候选池 API =====
# 填好下面两项，/募选管理 导入候选池 就能一直拉到正确的名单，跟 bot 部署在哪个服务器无关。
# 1) 接口验证令牌
ELECTION_APPROVED_API_TOKEN=
# 2) 候选池所在社区的 guild id（决定拉哪个社区的通过名单）
ELECTION_APPROVED_API_GUILD_ID=
# 3) 接口地址（旧募选 bot 提供）。代码里不再内置地址，必须在这里或配置面板填写。
ELECTION_APPROVED_API_BASE=

# ===== 募选模块：测试模式（仅测试服用） =====
# 设为 true 后会多出 /募选测试 命令，可凭空造候选池/候选人/投票来跑通流程。
# 生产环境请保持 false 或留空——否则 /募选测试 会出现在命令列表里。
ELECTION_TEST_MODE=false
# ===== 标题与 TAG 规范模块：LLM（OpenAI 兼容协议） =====
# 只有冲突沾上标题主体时才会调用，绝大多数帖子不会走到这里。
# 不填这三项 = 不启用 LLM，规则类判定（黑名单/标记段冲突/TAG 互斥）照常工作。
TITLEGUARD_LLM_BASE_URL=
TITLEGUARD_LLM_API_KEY=
TITLEGUARD_LLM_MODEL=
# 协议：chat = Chat Completions，responses = Responses API
TITLEGUARD_LLM_PROTOCOL=chat
# 超时算的是**闲置时间**：连续这么久一个字节都没回来才算卡死，不是总时长。
# 模型想得慢不会触发它——只要还在往回吐 token，计时器就一直被刷新。
TITLEGUARD_LLM_TIMEOUT_MS=240000
# 走不走流式，默认走。开着「闲置超时」才有意义：非流式的服务端要等模型整段生成完
# 才发第一个字节，那段时间连接上一片死寂，闲置超时就退化成了总超时。
# 万一你的网关不支持流式 tool call，填 0 关掉。
TITLEGUARD_LLM_STREAM=1
# 让模型交出结构化结果的方式：
#   cascade（默认）= 按 强制tool call → 模型自行决定 → JSON输出 依次降级，成功哪个记住哪个
#   forced / auto / json = 锁定某一种
# 思考/推理模式的模型（DeepSeek R1、各家 thinking 版本）通常不接受强制 tool_choice，
# 会报 "Thinking mode does not support this tool_choice"，保持 cascade 即可自动兜住。
TITLEGUARD_LLM_TOOL_MODE=cascade
